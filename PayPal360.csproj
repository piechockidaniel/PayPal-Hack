<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);checks/**;integration-checks/**;PayPal360.Contracts/**;design/**;data/**</DefaultItemExcludes>
    <UserSecretsId>ea3c352a-681c-4f73-978b-211856254b4e</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="checks/**/*.cs;integration-checks/**/*.cs;PayPal360.Contracts/**/*.cs" />
    <ProjectReference Include="PayPal360.Contracts/PayPal360.Contracts.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
</Project>
