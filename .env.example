# Set as environment variables before starting; never commit actual credentials.
PAYPAL360_ADMIN_USERNAME=
PAYPAL360_ADMIN_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional production key protection. If set, startup fails closed when the certificate is missing.
PAYPAL360_DATA_PROTECTION_CERTIFICATE_PATH=
PAYPAL360_DATA_PROTECTION_CERTIFICATE_PASSWORD=
# Optional externally-held audit checkpoint signing secret; use at least 32 characters.
PAYPAL360_AUDIT_ANCHOR_SECRET=

