# Set as environment variables before starting; never commit actual credentials.
PAYPAL360_ADMIN_USERNAME=
PAYPAL360_ADMIN_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Optional public hostname allowed only for the PayPal webhook route when a
# trusted loopback reverse proxy/tunnel forwards to this local application.
PAYPAL360_WEBHOOK_HOST=paypal.connect-the-dots.biz
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional production key protection. If set, startup fails closed when the certificate is missing.
PAYPAL360_DATA_PROTECTION_CERTIFICATE_PATH=
PAYPAL360_DATA_PROTECTION_CERTIFICATE_PASSWORD=
# Optional externally-held audit checkpoint signing secret; use at least 32 characters.
PAYPAL360_AUDIT_ANCHOR_SECRET=
# Optional read-only Google Merchant Center catalog connector. Keep the JSON
# service-account key outside this repository; the local catalog remains the
# checkout source of truth.
GMC_MERCHANT_ACCOUNT_ID=
GMC_SERVICE_ACCOUNT_JSON=
GMC_TENANT_ID=local

